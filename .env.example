# Copy to .env and fill in from your Supabase project's API settings.
# Both values are safe to ship in the app (anon/publishable key is RLS-protected).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# openrouteservice key for the route-safety Edge Function (free at openrouteservice.org).
# Server-side only: `npx supabase secrets set ORS_API_KEY=<key>`. No EXPO_PUBLIC_ prefix, so it never ships in the app.
ORS_API_KEY=your-openrouteservice-key
